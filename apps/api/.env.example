# Safe default: review mode accepts no customer account/payment data.
CUSTOMER_RELEASE_ENABLED=false
PORT=10000
# Customer mode stays blocked until independent durable/backup/mail/provider checks pass.
DURABLE_DATABASE_CONFIRMED=false
DATABASE_URL=
DATABASE_SSL=false
APP_ORIGIN=https://dispatch-check.nex2i.com
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
# Isolated sandbox credentials only; live keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional integration-test DB only; tests create/drop disposable child databases.
TEST_DATABASE_URL=
